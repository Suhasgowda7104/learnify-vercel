# MongoDB Configuration (Choose one approach)

# Option 1: MongoDB Connection String (Recommended)
MONGODB_URI=mongodb://localhost:27017/learnify_development

# Option 2: Separate MongoDB Variables
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DATABASE=learnify_development

# Legacy PostgreSQL Configuration (if still using PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-development-jwt-secret

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual database credentials
# 3. For MongoDB: Make sure MongoDB is running on your system
# 4. For PostgreSQL: Make sure PostgreSQL is running on your system
# 5. Create a database with the name specified in the configuration