{
  "version": 2,
  "name": "learnify-server",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/",
      "destination": "/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": ["iad1"],
  "installCommand": "npm install",
  "buildCommand": "echo 'No build step required'",
  "outputDirectory": ".",
  "framework": null
}